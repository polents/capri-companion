<Window x:Class="CapriCompanion.Windows.MainframeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri Mainframe" Width="570" Height="760" MinWidth="510" MinHeight="650"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        Background="#FF0B1017" Loaded="OnLoaded">
    <Border BorderBrush="#FF38515F" BorderThickness="1" CornerRadius="13" Background="#FF0B1017">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" MouseLeftButtonDown="DragWindow" Margin="3,0,3,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="◈" FontSize="24" Foreground="#FF54E7F2" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="MAINFRAME" FontFamily="Consolas" FontWeight="Bold" FontSize="15" Foreground="#FF54E7F2" />
                        <TextBlock Text="CAPRI / LOCAL CONTROL LINK" FontFamily="Consolas" FontSize="9" Foreground="#FF91A0AC" />
                    </StackPanel>
                </StackPanel>
                <Button Content="×" DockPanel.Dock="Right" Padding="10,4" FontSize="16" Click="CloseMainframe" />
            </DockPanel>

            <TabControl Grid.Row="1" Background="#FF0F151D" BorderBrush="#FF27323E" Foreground="#FFEFF4F7">
                <TabItem Header="LOOK">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16" >
                            <TextBlock Text="PRESENTATION" FontFamily="Consolas" FontSize="11" Foreground="#FF54E7F2" FontWeight="Bold" />
                            <TextBlock Text="Choose Capri's colorway and entrance." Foreground="#FF9AA8B4" FontSize="11" Margin="0,3,0,13" />
                            <Image Source="Assets/capri-main.png" Height="185" Stretch="Uniform" Margin="0,4,0,12" />
                            <TextBlock Text="WHAT SHOULD SHE CALL YOU?" FontFamily="Consolas" FontSize="10" Foreground="#FF9AA8B4" />
                            <TextBox Text="{Binding Settings.UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,14" />
                            <TextBlock Text="COLORWAY" FontFamily="Consolas" FontSize="10" Foreground="#FF9AA8B4" />
                            <ComboBox x:Name="PalettePicker" Margin="0,5,0,14" SelectedItem="{Binding Settings.Palette, Mode=TwoWay}" />
                            <TextBlock Text="STARTUP INTRO" FontFamily="Consolas" FontSize="10" Foreground="#FF9AA8B4" />
                            <ComboBox x:Name="WakePicker" Margin="0,5,0,15" SelectedItem="{Binding Settings.Wake, Mode=TwoWay}" />
                            <DockPanel>
                                <TextBlock Text="PET SIZE" FontFamily="Consolas" FontSize="10" Foreground="#FF9AA8B4" />
                                <TextBlock x:Name="ScaleLabel" DockPanel.Dock="Right" Foreground="#FF54E7F2" FontFamily="Consolas" />
                            </DockPanel>
                            <Slider x:Name="ScaleSlider" Minimum=".6" Maximum="1.45" Value="{Binding PetScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Startup intro applies next time Capri launches. Drag her to move her. Right-click for Chat, Mainframe, size, hide, and quit." Foreground="#FF8796A1" FontSize="10" Margin="0,9,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="PERSONALITY">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <TextBlock Text="PERSONALITY" FontFamily="Consolas" FontSize="11" Foreground="#FF54E7F2" FontWeight="Bold" />
                            <TextBlock Text="Tune how Capri talks. Changes are saved on this PC." Foreground="#FF9AA8B4" FontSize="11" Margin="0,3,0,12" />
                            <TextBlock Text="SPEAKING STYLE" FontFamily="Consolas" FontSize="10" Foreground="#FF9AA8B4" />
                            <ComboBox x:Name="StylePicker" Margin="0,5,0,12" SelectedItem="{Binding Settings.SpeakingStyle, Mode=TwoWay}" />
                            <TextBlock Text="MOOD" FontFamily="Consolas" FontSize="10" Foreground="#FF9AA8B4" />
                            <ComboBox x:Name="MoodPicker" Margin="0,5,0,12" SelectedItem="{Binding Settings.Mood, Mode=TwoWay}" />
                            <TextBlock Text="HUMOR" /><Slider Minimum="0" Maximum="1" Value="{Binding Settings.Humor, Mode=TwoWay}" /><TextBlock Text="DRY  ← →  GOOFY" Foreground="#FF8796A1" FontSize="9" />
                            <TextBlock Text="FRIENDLINESS" Margin="0,13,0,0" /><Slider Minimum="0" Maximum="1" Value="{Binding Settings.Friendliness, Mode=TwoWay}" /><TextBlock Text="RESERVED  ← →  WARM" Foreground="#FF8796A1" FontSize="9" />
                            <TextBlock Text="SASS" Margin="0,13,0,0" /><Slider Minimum="0" Maximum="1" Value="{Binding Settings.Sass, Mode=TwoWay}" /><TextBlock Text="GENTLE  ← →  CHEEKY" Foreground="#FF8796A1" FontSize="9" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="BEHAVIOR">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <TextBlock Text="PRESENCE WITHOUT PRESSURE" FontFamily="Consolas" FontSize="11" Foreground="#FF54E7F2" FontWeight="Bold" />
                            <TextBlock Text="Proactivity" Margin="0,18,0,0" /><Slider Minimum="0" Maximum="1" Value="{Binding Settings.Proactivity, Mode=TwoWay}" />
                            <DockPanel Margin="0,10,0,12">
                                <TextBlock Text="CHECK-IN WINDOW" FontFamily="Consolas" FontSize="10" Foreground="#FF9AA8B4" VerticalAlignment="Center" />
                                <ComboBox x:Name="CheckInPicker" Width="115" DockPanel.Dock="Right" SelectedValuePath="Minutes" DisplayMemberPath="Label" SelectedValue="{Binding Settings.CheckInMinutes, Mode=TwoWay}" />
                            </DockPanel>
                            <CheckBox Content="Quiet Mode · no spontaneous check-ins" IsChecked="{Binding Settings.QuietMode, Mode=TwoWay}" />
                            <Border Background="#FF111820" BorderBrush="#FF344451" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="SCREEN COMMENTARY" FontFamily="Consolas" FontWeight="Bold" Foreground="#FFFFC66D" />
                                    <TextBlock Text="Screen reading is not enabled in this Windows build. Capri does not inspect your screen." FontSize="11" Foreground="#FFB4BEC5" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="BRAIN">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <TextBlock Text="LOCAL OLLAMA LINK" FontFamily="Consolas" FontSize="11" Foreground="#FF54E7F2" FontWeight="Bold" />
                            <TextBlock x:Name="BrainStatus" Text="Checking local Ollama…" TextWrapping="Wrap" Margin="0,8,0,15" />
                            <TextBlock Text="MODEL TAG" FontFamily="Consolas" FontSize="10" Foreground="#FF9AA8B4" />
                            <TextBox Text="{Binding Settings.Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" />
                            <ComboBox x:Name="ModelPicker" ItemsSource="{Binding InstalledModels}" Margin="0,0,0,10" SelectionChanged="ModelSelected" />
                            <WrapPanel>
                                <Button Content="REFRESH" Click="RefreshModels" Margin="0,0,8,0" />
                                <Button x:Name="PullButton" Content="PULL SELECTED MODEL" Click="PullModel" />
                            </WrapPanel>
                            <TextBlock Text="Preferred: gemma4:e4b. If missing, choose an installed Gemma 4 E4B variant or enter another local Ollama model. Chat and memory stay on this PC; there is no cloud fallback." Foreground="#FF9AA8B4" FontSize="11" Margin="0,16,0,0" />
                            <TextBlock x:Name="BrainMessage" TextWrapping="Wrap" Foreground="#FFFFC66D" FontSize="10" Margin="0,13,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="VOICE">
                    <StackPanel Margin="16">
                        <TextBlock Text="OPTIONAL WINDOWS SPEECH" FontFamily="Consolas" FontSize="11" Foreground="#FF54E7F2" FontWeight="Bold" />
                        <TextBlock Text="Speech uses Windows' installed language and voice support. Dictation starts only when you press the microphone in chat." Foreground="#FF9AA8B4" FontSize="11" Margin="0,5,0,14" />
                        <CheckBox Content="Enable speech input" IsChecked="{Binding Settings.VoiceInput, Mode=TwoWay}" />
                        <CheckBox Content="Speak Capri's replies" IsChecked="{Binding Settings.SpokenReplies, Mode=TwoWay}" />
                        <TextBlock Text="SPOKEN VOICE" FontFamily="Consolas" FontSize="10" Foreground="#FF9AA8B4" Margin="0,14,0,0" />
                        <ComboBox x:Name="VoicePicker" Margin="0,5,0,0" SelectionChanged="VoiceSelected" />
                        <TextBlock x:Name="VoiceStatus" Text="Microphone remains off until you tap it in chat." Foreground="#FF8796A1" FontSize="10" Margin="0,14,0,0" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="MEMORY">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="MEMORY / STORED ON THIS PC" FontFamily="Consolas" FontSize="11" Foreground="#FF54E7F2" FontWeight="Bold" />
                            <TextBlock Text="Add details Capri may use in later chats. Review or remove them whenever you like." Foreground="#FF9AA8B4" FontSize="11" Margin="0,4,0,10" />
                        </StackPanel>
                        <ListBox x:Name="MemoryList" Grid.Row="1" ItemsSource="{Binding Memories}" DisplayMemberPath="Text" SelectionChanged="SelectMemory" Background="#FF0D1219" Foreground="#FFEAF0F4" BorderBrush="#FF344451" />
                        <TextBox x:Name="MemoryEditor" Grid.Row="2" MinHeight="70" Margin="0,10,0,8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
                            <Button Content="ADD" Click="AddMemory" Margin="0,0,7,0" />
                            <Button Content="SAVE EDIT" Click="SaveMemory" Margin="0,0,7,0" />
                            <Button Content="DELETE" Click="DeleteMemory" />
                        </WrapPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="2" Text="LOCAL DATA ONLY  ·  OLLAMA AT 127.0.0.1:11434  ·  NO CLOUD FALLBACK"
                       FontFamily="Consolas" FontSize="8" Foreground="#FF798994" VerticalAlignment="Center" Margin="4,5,0,0" />
        </Grid>
    </Border>
</Window>
