<Window x:Class="CapriCompanion.Windows.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capri Chat" Width="390" Height="650" MinWidth="350" MinHeight="560"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent"
        Loaded="OnLoaded" Closed="OnClosed">
    <Window.Resources>
        <DataTemplate x:Key="ChatBubbleTemplate">
            <Border HorizontalAlignment="{Binding Alignment}" MaxWidth="310" Margin="4,4,4,3"
                    Padding="10,7" CornerRadius="9">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#DD18212B" />
                        <Setter Property="BorderBrush" Value="#553D5863" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Role}" Value="you">
                                <Setter Property="Background" Value="#DD172A34" />
                                <Setter Property="BorderBrush" Value="#AA54E7F2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="9" Foreground="#FF54E7F2" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#FFF2F5F7" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="WindowRoot" Background="Transparent" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="39" />
            <RowDefinition Height="*" />
            <RowDefinition Height="178" />
            <RowDefinition Height="54" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#D30C1118" BorderBrush="#FF34414E" BorderThickness="1" CornerRadius="12"
                MouseLeftButtonDown="DragWindow">
            <DockPanel Margin="10,0">
                <TextBlock Text="CAPRI  /  LOCAL CHANNEL" Foreground="#FF54E7F2" FontFamily="Consolas" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="MAINFRAME" FontFamily="Consolas" FontSize="9" Padding="8,4" Margin="4,0" Click="OpenMainframe" />
                    <Button Content="×" FontSize="15" Padding="7,1" Click="CloseChat" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" Margin="2,8,2,4" VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource ChatBubbleTemplate}" />
        </ScrollViewer>

        <!-- The PNG carries alpha; this row deliberately has no backdrop so Capri sits directly on the desktop. -->
        <Grid Grid.Row="2" Background="Transparent">
            <Image Source="Assets/capri-main.png" Stretch="Uniform" Margin="4,0,4,2" IsHitTestVisible="False">
                <Image.Effect><DropShadowEffect Color="#FFFF2B75" BlurRadius="22" ShadowDepth="0" Opacity=".35" /></Image.Effect>
            </Image>
        </Grid>

        <Border Grid.Row="3" Background="#EF080C12" BorderBrush="#FF54E7F2" BorderThickness="1.2" CornerRadius="12" Padding="8,4">
            <DockPanel>
                <Button x:Name="MicButton" Content="◖" ToolTip="Start or stop speech input" Padding="8,3" Margin="0,0,7,0" Click="ToggleMicrophone" />
                <Button Content="SEND" FontFamily="Consolas" FontSize="10" Foreground="#FFFF2B75" Padding="9,3" DockPanel.Dock="Right" Click="SendMessage" />
                <TextBox x:Name="MessageInput" BorderThickness="0" Background="Transparent" Padding="3,5"
                         FontFamily="Consolas" FontSize="12" Text="" KeyDown="InputKeyDown" TextChanged="InputChanged"
                         ToolTip="Type to Capri; press Enter to send" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="4,4,4,0">
            <TextBlock x:Name="StatusText" Text="Local chat · no cloud fallback" Foreground="#FF9AA8B4" FontSize="9" VerticalAlignment="Center" />
            <TextBlock Text="DRAG HEADER TO MOVE" Foreground="#FF74828F" FontFamily="Consolas" FontSize="8" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
